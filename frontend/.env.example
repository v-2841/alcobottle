# Публичный URL сайта (вход Caddy / домен в проде).
# Используется для canonical/OpenGraph, sitemap.xml и robots.txt.
SITE_URL=http://localhost:8000

# Базовый URL Django API — серверные запросы Next ходят сюда напрямую.
# В Docker это имя сервиса бэкенда из compose.
API_BASE=http://backend:8000

# ID виджета чата Jivo (из кода установки code.jivo.ru/widget/<ID>).
# Пусто — виджет не подключается.
JIVO_WIDGET_ID=
